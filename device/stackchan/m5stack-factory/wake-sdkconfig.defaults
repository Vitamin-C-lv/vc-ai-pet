# Phase 4.2 local wake: only the strict first phrase is detected on-device.
CONFIG_USE_CUSTOM_WAKE_WORD=y
# CONFIG_USE_AFE_WAKE_WORD is not set
# CONFIG_USE_ESP_WAKE_WORD is not set
CONFIG_CUSTOM_WAKE_WORD="hua hua"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="花花"
CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=25
CONFIG_SEND_WAKE_WORD_DATA=n
CONFIG_SR_MN_CN_NONE=n
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
