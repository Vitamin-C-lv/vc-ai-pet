+    }
+
+    bool IsDischarging()
+    {
+        uint8_t power_status = 0;
+        if (TryReadRegs(0x01, &power_status, 1, 100) != ESP_OK) {
+            ESP_LOGW(TAG, "AXP2101 discharge status read failed; keeping last state");
+            return last_discharging_;
+        }
+        last_discharging_ = ((power_status & 0b01100000) >> 5) == 2;
+        return last_discharging_;
+    }
