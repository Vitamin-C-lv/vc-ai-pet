+        uint8_t power_status = 0;
+        if (TryReadRegs(0x01, &power_status, 1, 100) != ESP_OK) {
+            ESP_LOGW(TAG, "AXP2101 power status read failed; keeping last power state");
+            return last_external_power_connected_;
+        }
         const uint8_t current_direction = (power_status & 0b01100000) >> 5;
